# Copy to .env (git-ignored) and change the password, or run `make docker-env` to write one with a random password.
POSTGRES_PASSWORD=change-me
# Host port of the web interface (bound to 127.0.0.1). If you change it, add the new origin below.
WEB_PORT=8080
# Origins allowed to write through the API besides the web container itself (JSON list)
DF_ALLOWED_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080"]
DF_RATE_LIMIT_PREDICT=60
DF_RATE_LIMIT_REFERENCE=120
# true: the API reads the client address from X-Forwarded-For, which the web container overwrites (default in compose)
DF_TRUST_PROXY=true
# Where the research checkout is (it holds data/ and research/); only the ETL and the dev containers read it
TOPIC_DIR=../..
# in-tiles (default, about 2.3 million rows) | degron-only (small, faster) | all | none
CLINVAR_SCOPE=in-tiles
# 1: build the backend image with PyTorch (CPU) + Transformers so the optional LoRA-D model can serve (plan 2.12).
# The ETL registers LoRA-D only when its serving bundle exists in data/processed/ (see backend/LORA.md).
WITH_LORA=0
# Effect model used when a request names none. Empty: the registry default (m3-ext4.0-platt-v1).
DF_DEFAULT_MODEL_ID=
# CPU threads PyTorch may use for LoRA-D
DF_LORA_THREADS=4
# VPS profile
SITE_ADDRESS=degron.example.org
