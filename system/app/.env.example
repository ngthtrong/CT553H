# Copy to .env (git-ignored) and change the password.
POSTGRES_PASSWORD=change-me
# Origin(s) allowed by CORS: the public address of the web container (JSON list)
DF_ALLOWED_ORIGINS=["http://localhost:8080"]
DF_RATE_LIMIT_PREDICT=60
DF_RATE_LIMIT_REFERENCE=120
# true only behind a reverse proxy you control (Caddy profile `vps`)
DF_TRUST_PROXY=false
WEB_PORT=8080
# Where the research checkout is (topics/degron-footprint); only the ETL reads it
TOPIC_DIR=../..
# in-tiles (default, about 2.3 million rows) | degron-only (small, for free-tier databases) | all | none
CLINVAR_SCOPE=in-tiles
# VPS profile
SITE_ADDRESS=degron.example.org
