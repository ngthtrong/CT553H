# Dữ liệu: nằm trong thư mục từng đề tài, KHÔNG BAO GIỜ đưa lên git.
# Sinh lại bằng script trong code/ hoặc research/ của đề tài đó.
# Chặn NỘI DUNG mọi thư mục data/ (không chặn chính thư mục) để README.md nguồn gốc
# dữ liệu bên trong vẫn lên git. SOURCE.md ở mọi độ sâu cũng lên git: nó giữ thông báo
# giấy phép và xuất xứ của từng bộ dữ liệu tải về (ví dụ thông báo MIT của Larsen 2025).
**/data/**
!**/data/README.md
!**/data/raw/
!**/data/raw/*/
!**/data/**/SOURCE.md

# Mô hình đã huấn luyện, kết quả nặng
topics/*/models/
archive/topics/*/models/
*.pkl
*.joblib
*.pt
*.safetensors

# Python
__pycache__/
.venv/
venv/
.ipynb_checkpoints/

# Node / Java
node_modules/
target/
build/
dist/

# Bí mật
.env

# LaTeX (chỉ giữ .tex, .bib và .pdf)
*.aux
*.bbl
*.blg
*.log
*.out
*.toc
*.xdv
*.fls
*.fdb_latexmk
*.synctex.gz

# Ứng dụng (topics/*/system/app): CSDL sinh ra khi chạy, độ phủ, kết quả kiểm thử. Không bao giờ đưa lên git
# (dev.db 453 MB và idem.db 122 MB đã từng lọt vào một commit vì `.data/` có dấu chấm không khớp `**/data/**`).
**/.data/
**/.coverage
**/test-results/
**/coverage/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.hypothesis/
