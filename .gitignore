# Dữ liệu: nằm trong thư mục từng đề tài, KHÔNG BAO GIỜ đưa lên git.
# Sinh lại bằng script trong code/ hoặc research/ của đề tài đó.
# Chặn NỘI DUNG mọi thư mục data/ (không chặn chính thư mục) để README.md nguồn gốc
# dữ liệu bên trong vẫn lên git. SOURCE.md ở mọi độ sâu cũng lên git: nó giữ thông báo
# giấy phép và xuất xứ của từng bộ dữ liệu tải về (ví dụ thông báo MIT của Larsen 2025).
**/data/**
!**/data/README.md
!**/data/raw/
!**/data/raw/*/
!**/data/**/SOURCE.md

# Mô hình đã huấn luyện, kết quả nặng
topics/*/models/
archive/topics/*/models/
*.pkl
*.joblib
*.pt
*.safetensors

# Output Kaggle/local: mặc định chặn mọi file, chỉ mở metadata/báo cáo local.
# Phải mở từng thư mục cha để Git xét các ngoại lệ bên dưới.
# Không mở toàn bộ *.json/CSV trong output: weights/tokenizer và dữ liệu vẫn ở local.
/topics/degron-footprint/research/kaggle-roadmap-2026-10-31/output/**
!/topics/degron-footprint/research/kaggle-roadmap-2026-10-31/output/local/
!/topics/degron-footprint/research/kaggle-roadmap-2026-10-31/output/local/*/

# Bằng chứng theo campaign: kế hoạch, DAG, trạng thái/hash và lý do thay thế.
# latest/session/progress, khóa, STOP và log không được mở ngoại lệ.
!/topics/degron-footprint/research/kaggle-roadmap-2026-10-31/output/local/*/plan.json
!/topics/degron-footprint/research/kaggle-roadmap-2026-10-31/output/local/*/queue.json
!/topics/degron-footprint/research/kaggle-roadmap-2026-10-31/output/local/*/state.json
!/topics/degron-footprint/research/kaggle-roadmap-2026-10-31/output/local/*/superseded.json
!/topics/degron-footprint/research/kaggle-roadmap-2026-10-31/output/local/*/jobs/
!/topics/degron-footprint/research/kaggle-roadmap-2026-10-31/output/local/*/jobs/*/
# JSON ngay dưới job: fit, worker-result, preflight/lock, manifest, results,
# collection/comparisons, pending và evidence; không cho tensor/OOF đi kèm.
!/topics/degron-footprint/research/kaggle-roadmap-2026-10-31/output/local/*/jobs/*/*.json
!/topics/degron-footprint/research/kaggle-roadmap-2026-10-31/output/local/*/jobs/collect-*/summary.csv
!/topics/degron-footprint/research/kaggle-roadmap-2026-10-31/output/local/*/jobs/report/benchmark.csv

# Calibration và locked transfer ghi model-card/selection-lock trong thư mục recipe.
!/topics/degron-footprint/research/kaggle-roadmap-2026-10-31/output/local/*/jobs/calibrate-core/*/
!/topics/degron-footprint/research/kaggle-roadmap-2026-10-31/output/local/*/jobs/calibrate-core/*/model-card.json
!/topics/degron-footprint/research/kaggle-roadmap-2026-10-31/output/local/*/jobs/calibrate-core/*/selection-lock.json
!/topics/degron-footprint/research/kaggle-roadmap-2026-10-31/output/local/*/jobs/locked-transfer-w5/*/
!/topics/degron-footprint/research/kaggle-roadmap-2026-10-31/output/local/*/jobs/locked-transfer-w5/*/model-card.json
!/topics/degron-footprint/research/kaggle-roadmap-2026-10-31/output/local/*/jobs/locked-transfer-w5/*/selection-lock.json

# Nguồn/revision/SHA của weights dùng chung; không mở thư mục snapshot revision.
!/topics/degron-footprint/research/kaggle-roadmap-2026-10-31/output/local/weights/*/
!/topics/degron-footprint/research/kaggle-roadmap-2026-10-31/output/local/weights/*/SOURCE.md
!/topics/degron-footprint/research/kaggle-roadmap-2026-10-31/output/local/weights/*/status.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# Node / Java
node_modules/
target/
build/
# Cho phép .gitignore riêng của hai bản LaTeX chọn PDF cần giữ.
!/reportTemplate/build/
!/topics/degron-footprint/report/build/
dist/

# Bí mật
.env

# LaTeX: bỏ qua tệp trung gian, giữ nguồn và tài sản trình bày
*.aux
*.bbl
*.blg
*.log
*.out
*.toc
*.xdv
*.fls
*.fdb_latexmk
*.synctex.gz
*.bcf
*.run.xml
*.lof
*.lot
*.nav
*.snm
*.vrb

# Ứng dụng (topics/*/system/app): CSDL sinh ra khi chạy, độ phủ, kết quả kiểm thử. Không bao giờ đưa lên git
# (dev.db 453 MB và idem.db 122 MB đã từng lọt vào một commit vì `.data/` có dấu chấm không khớp `**/data/**`).
**/.data/
**/.coverage
**/test-results/
**/coverage/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.hypothesis/

# Siêu dữ liệu "đã tải từ Internet" của Windows (sinh khi chép tệp qua WSL), không có giá trị
*:Zone.Identifier
